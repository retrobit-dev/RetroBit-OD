<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_margin">

        <TextView
            style="@style/RowHint"
            android:layout_marginTop="0dp"
            android:text="@string/card_hint" />

        <LinearLayout style="@style/RowItem">

            <TextView
                style="@style/RowLabel"
                android:text="@string/card_enable" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/groupCardMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeData"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/card_mode_data"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeImage"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/card_mode_image"
                android:textSize="11sp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            style="@style/SectionTitle"
            android:text="@string/card_photo" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgPhoto"
                android:layout_width="72dp"
                android:layout_height="92dp"
                android:layout_marginEnd="12dp"
                android:background="@color/surface_high"
                android:contentDescription="@string/card_photo"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickPhoto"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/card_pick" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearPhoto"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/card_clear" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:text="@string/card_image" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgCard"
                android:layout_width="120dp"
                android:layout_height="76dp"
                android:layout_marginEnd="12dp"
                android:background="@color/surface_high"
                android:contentDescription="@string/card_image"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickCard"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/card_pick" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearCard"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/card_clear" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:text="@string/title_card" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilName"
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/card_field_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="48" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNip"
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/card_field_nip">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtNip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="24" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/card_field_rank">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtRank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:maxLength="32" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/card_field_position">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtPosition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:maxLength="40" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/card_field_unit">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtUnit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
            android:inputType="textMultiLine|textCapWords"
                android:maxLength="60" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/card_field_institution">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtInstitution"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
            android:inputType="textCapWords"
                android:maxLength="48" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/card_field_qr">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtQr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:maxLength="300" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/card_field_note">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
            android:inputType="textCapWords"
                android:maxLength="40" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/PixelButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/card_save" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSavePreview"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/btn_save_preview"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
